{
	"schemaVersion": 1,
	"id": "ifuto-replay",
	"version": "${version}",
	"name": "Ifuto Replay",
	"description": "An ultra-lightweight packet recorder for Minecraft. It saves the raw network stream (server to client, optionally client to server) while you play, so playback and export can use any FPS and resolution you like. No per-frame capture, no FPS drop while recording.",
	"authors": [
		"ifuto"
	],
	"contact": {
		"homepage": "https://github.com/ifuto/ifuto-zoom",
		"sources": "https://github.com/ifuto/ifuto-zoom",
		"issues": "https://github.com/ifuto/ifuto-zoom/issues"
	},
	"license": "MIT",
	"icon": "assets/ifuto-replay/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.ifuto.replay.IfutoReplayClient"
		],
		"modmenu": [
			"com.ifuto.replay.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "ifuto-replay.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
