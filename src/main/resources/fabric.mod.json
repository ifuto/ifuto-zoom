{
	"schemaVersion": 1,
	"id": "ifuto-zoom",
	"version": "${version}",
	"name": "Ifuto Zoom",
	"description": "A smooth, configurable zoom for Minecraft. Hold (or toggle) C for a 3x zoom and scroll to zoom further in or out.",
	"authors": [
		"ifuto"
	],
	"contact": {
		"homepage": "https://github.com/ifuto/ifuto-zoom",
		"sources": "https://github.com/ifuto/ifuto-zoom",
		"issues": "https://github.com/ifuto/ifuto-zoom/issues"
	},
	"license": "MIT",
	"icon": "assets/ifuto-zoom/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.ifuto.zoom.IfutoZoomClient"
		],
		"modmenu": [
			"com.ifuto.zoom.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "ifuto-zoom.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
